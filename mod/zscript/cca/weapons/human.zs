extend class CCAWeapon
{
	// pump sound + a red shell out of the port
	action void CCA_PumpShell()
	{
		A_StartSound("weapons/pump", CHAN_WEAPON);
		let c = Spawn("CCAShellCasing", pos + (0, 0, player ? player.viewheight - 10 : 30) + (AngleToVector(angle - 60, 10), 0));
		if (c) { c.Vel3DFromAngle(frandom(3, 5), angle - 100 + frandom(-15, 15), frandom(-50, -30)); c.Vel += Vel; }
	}
}
