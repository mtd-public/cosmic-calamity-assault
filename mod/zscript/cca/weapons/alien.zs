// GENERATED by the table in this repo's history (see GAME_DESIGN.md §5.1 for
// the numbers and their reasons); state layout documented in weapons/base.zs.
// Numbers: damage is Doom-style N*random(a,b); spreads in degrees; Kick is the
// recoil pitch in degrees; reload tics scale with the gun's size.

// All alien weapons draw from one universal ammo: AlienEnergy.

// Harvester blade: slot 1 alternative. Fire = two-hit combo, alt = heavy lunge.
class CCA_HarvesterBlade : CCAWeapon
{
	Default
	{
		Weapon.SlotNumber 1;
		Weapon.SelectionOrder 3600;
		CCAWeapon.MagSize 0;
		CCAWeapon.ADSZoom 0;
		CCAWeapon.CanDual 0;
		CCAWeapon.Reticle 0;
		Tag "$C51_TAG_BLADE";
		Inventory.PickupMessage "$C51_GOT_BLADE";
		+WEAPON.MELEEWEAPON
	}
	States
	{
	Spawn:
		WABL A -1;
		Stop;
	Select:
		ABLD A 1 CCA_Select;
		Loop;
	Deselect:
		ABLD A 1 CCA_Deselect;
		Loop;
	Ready:
		ABLD A 1 CCA_Ready;
		Loop;
	Fire:
		ABLD B 3;
		ABLD C 2 CCA_Melee(88, 5, 4, 10);
		ABLD D 4;
		ABLD E 3;
		ABLD F 2 CCA_Melee(88, 5, 4, 10);
		ABLD G 5;
		ABLD A 3;
		Goto Ready;
	AltFire:
		ABLD E 4;
		ABLD F 3 CCA_Melee(96, 9, 4, 10, true);
		ABLD G 10;
		ABLD A 4;
		Goto Ready;
	}
}

class CCA_Stinger : CCAWeapon
{
	Default
	{
		Weapon.SlotNumber 2;
		Weapon.SelectionOrder 1800;
		Weapon.AmmoType1 "AlienEnergy";
		Weapon.AmmoGive1 30;
		CCAWeapon.MagSize 0;
		CCAWeapon.Damage 0, 0, 0;
		CCAWeapon.Pellets 1;
		CCAWeapon.SpreadHip 1.2;
		CCAWeapon.SpreadADS 0.2;
		CCAWeapon.ADSZoom 1.35;
		CCAWeapon.Kick 0.9;
		CCAWeapon.FireSound "weapons/stinger";
		CCAWeapon.SemiAuto 1;
		CCAWeapon.Reticle 5;
		Tag "$C51_TAG_STINGER";
		Inventory.PickupMessage "$C51_GOT_STINGER";
		CCAWeapon.Projectile "CCAStingerBolt";
		CCAWeapon.AmmoPerShot 1;
	}
	States
	{
	Spawn:
		WAST A -1;
		Stop;
	Select:
		ASTG A 1 CCA_Select;
		Loop;
	Deselect:
		ASTG A 1 CCA_Deselect;
		Loop;
	Ready:
		ASTG A 1 CCA_Ready;
		Loop;
	Fire:
		ASTG B 1 CCA_Fire;
		ASTG C 6;
		ASTG A 2;
		Goto Ready;
	Flash:
		ASTG X 2 Bright;
		Stop;
	ADSIn:
		ASTG O 2;
		Goto ADSReady;
	ADSReady:
		ASTG L 1 CCA_Ready;
		Loop;
	ADSFire:
		ASTG M 1 CCA_Fire;
		ASTG N 6;
		ASTG L 2;
		Goto ADSReady;
	ADSFlash:
		ASTG Y 2 Bright;
		Stop;
	ADSOut:
		ASTG O 2;
		Goto Ready;
	Reload:
		Goto Ready;
	LeftReload:
		Goto LeftReady;
	LeftReady:
		ASTG A 1 CCA_LeftReady;
		Loop;
	LeftFire:
		ASTG B 1 CCA_LeftFire;
		ASTG C 6;
		ASTG A 2;
		Goto LeftReady;
	LeftFlash:
		ASTG X 2 Bright;
		Stop;
	}
}

