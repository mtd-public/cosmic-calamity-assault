// GENERATED by the table in this repo's history (see GAME_DESIGN.md §5.1 for
// the numbers and their reasons); state layout documented in weapons/base.zs.
// Numbers: damage is Doom-style N*random(a,b); spreads in degrees; Kick is the
// recoil pitch in degrees; reload tics scale with the gun's size.

// Combat knife: slot 1. Fire = slash, alt-fire = stab lunge (no ADS, no dual).
class CCA_Knife : CCAWeapon
{
	Default
	{
		Weapon.SlotNumber 1;
		Weapon.SelectionOrder 3700;
		CCAWeapon.MagSize 0;
		CCAWeapon.ADSZoom 0;
		CCAWeapon.CanDual 0;
		CCAWeapon.Reticle 0;
		Tag "$C51_TAG_KNIFE";
		+WEAPON.MELEEWEAPON
	}
	States
	{
	Spawn:
		MELE A -1;
		Stop;
	Select:
		KNIF A 1 CCA_Select;
		Loop;
	Deselect:
		KNIF A 1 CCA_Deselect;
		Loop;
	Ready:
		KNIF A 1 CCA_Ready;
		Loop;
	Fire:
		KNIF B 2;
		KNIF C 2 CCA_Melee(72, 3, 4, 10);
		KNIF D 3;
		KNIF E 4;
		KNIF A 3;
		Goto Ready;
	AltFire:
		KNIF F 3;
		KNIF G 3 CCA_Melee(84, 5, 4, 10, true);
		KNIF H 8;
		KNIF A 4;
		Goto Ready;
	}
}

