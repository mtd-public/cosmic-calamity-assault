		SHOT E 4;
		SHOT F 5 CCA_InsertShell;
		SHOT F 0 CCA_ShellCheck("ReloadEnd");
		Loop;
	ReloadEnd:
		SHOT G 4 CCA_PumpShell;
		SHOT H 5;
		Goto Ready;
	LeftReload:
		SHOT D 5;
	LeftReloadLoop:
		SHOT E 4;
		SHOT F 5 CCA_InsertShell(true);
		SHOT F 0 CCA_ShellCheck("LeftReloadEnd", true);
		Loop;
	LeftReloadEnd:
		SHOT G 4;
		SHOT H 5;
		Goto LeftReady;
	LeftReady:
		SHOT A 1 CCA_LeftReady;
		Loop;
	LeftFire:
		SHOT B 1 CCA_LeftFire;
		SHOT B 3;
		SHOT C 6;
		SHOT G 6;
		SHOT H 6;
		SHOT A 6;
		Goto LeftReady;
	LeftFlash:
		SHOT X 2 Bright;
		Stop;
	}
}

