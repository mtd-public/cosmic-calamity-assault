		CCAWeapon.AmmoPerShot 1;
		CCAWeapon.HeatPerShot 6;
	}
	States
	{
	Spawn:
		WAPS A -1;
		Stop;
	Select:
		APSM A 1 CCA_Select;
		Loop;
	Deselect:
		APSM A 1 CCA_Deselect;
		Loop;
	Ready:
		APSM A 1 CCA_Ready;
		Loop;
	Fire:
		APSM B 1 CCA_Fire;
		APSM C 2 CCA_HeatCheck;
		Goto Ready;
	Flash:
		APSM X 2 Bright;
		Stop;
	ADSIn:
		APSM O 2;
		Goto ADSReady;
	ADSReady:
		APSM L 1 CCA_Ready;
		Loop;
	ADSFire:
		APSM M 1 CCA_Fire;
		APSM N 2 CCA_HeatCheck;
		Goto ADSReady;
	ADSFlash:
		APSM Y 2 Bright;
		Stop;
	ADSOut:
		APSM O 2;
		Goto Ready;
	Vent:
		APSM D 3;
		APSM E 3;
		APSM F 4;
		APSM G 5;
		APSM H 6;
		APSM I 5;
		APSM J 4;
		APSM K 3 CCA_VentDone;
		Goto Ready;
	Reload:
		Goto Ready;
	LeftReload:
		Goto LeftReady;
	LeftReady:
		APSM A 1 CCA_LeftReady;
		Loop;
	LeftFire:
		APSM B 1 CCA_LeftFire;
		APSM C 2;
		Goto LeftReady;
	LeftFlash:
		APSM X 2 Bright;
		Stop;
	}
}


// The Singularity: charge, then a slow black-violet ball that tears at
// everything in view when it bursts (Doom's BFG spray). 40 energy a shot.
class CCA_Singularity : CCAWeapon
{
	Default
	{
		Weapon.SlotNumber 7;
		Weapon.SelectionOrder 2800;
		Weapon.AmmoType1 "AlienEnergy";
		Weapon.AmmoGive1 80;
		CCAWeapon.MagSize 0;
		CCAWeapon.AmmoPerShot 40;
		CCAWeapon.ADSZoom 0;
		CCAWeapon.CanDual 0;
		CCAWeapon.Projectile "CCASingularityBall";
		CCAWeapon.SpreadHip 0;
		CCAWeapon.Kick 4;
		CCAWeapon.FireSound "weapons/singfire";
		CCAWeapon.SemiAuto 1;
		CCAWeapon.Reticle 7;
		Tag "$C51_TAG_SING";
		Inventory.PickupMessage "$C51_GOT_SING";
	}
	States
	{
	Spawn:
		WSNG A -1;
		Stop;
	Select:
		SNGL A 1 CCA_Select;
		Loop;
	Deselect:
		SNGL A 1 CCA_Deselect;
		Loop;
	Ready:
		SNGL A 1 CCA_Ready;
		Loop;
	Fire:
		SNGL B 5 A_StartSound("weapons/singcharge", CHAN_WEAPON);
		SNGL C 5;
		SNGL D 5;
		SNGL E 5 Bright;
		SNGL F 5 Bright;
		SNGL G 4 Bright CCA_Fire;
		SNGL H 8;
		SNGL I 8;
		Goto Ready;
	Flash:
		TNT1 A 1;
		Stop;
	}
}

// ---------------------------------------------------------------- projectiles
class CCAStingerBolt : Actor
{
	Default { Radius 4; Height 6; Speed 55; DamageFunction (6 * random(2, 4)); Projectile; +RANDOMIZE; RenderStyle "Add"; Scale 0.5; DeathSound "weapons/boltimpact"; Obituary "$C51_OB_STINGER"; }
	States
	{
	Spawn:
		ASTB AB 2 Bright A_SpawnItemEx("CCABoltTrail", flags: SXF_CLIENTSIDE);
		Loop;
	Death:
		ASTB CDE 3 Bright;
		Stop;
	}
}
class CCABoltTrail : Actor
{
	Default { +NOINTERACTION; RenderStyle "Add"; Alpha 0.5; Scale 0.3; }
	States { Spawn: ASTB B 1 Bright A_FadeOut(0.12); Loop; }
}
class CCAScatterPellet : Actor
{
	Default { Radius 3; Height 4; Speed 42; DamageFunction (4 * random(1, 3)); Projectile; RenderStyle "Add"; Scale 0.45; PainChance 128; Obituary "$C51_OB_SCATTER"; }
	override int DoSpecialDamage(Actor target, int damage, Name damagetype)
	{
		// stagger: plasma pellets make things flinch far more often than bullets
		if (target && target.bIsMonster && random(0, 255) < 96) target.TriggerPainChance('None', true);
		return damage;
	}
	States
	{
	Spawn:
		ASCP A 1 Bright;
		Loop;
	Death:
		ASCP BC 3 Bright;
		Stop;
	}
}
class CCAPlasmaBolt : Actor
{
	Default { Radius 4; Height 6; Speed 48; DamageFunction (5 * random(1, 3)); Projectile; RenderStyle "Add"; Scale 0.5; DeathSound "weapons/plasmahit"; Obituary "$C51_OB_PLASMA"; }
	States
	{
	Spawn:
		APLS AB 2 Bright;
		Loop;
	Death:
		APLS CDE 3 Bright;
		Stop;
	}
}
class CCASingularityBall : Actor
{
	Default { Radius 13; Height 8; Speed 22; Damage 100; Projectile; +RANDOMIZE; RenderStyle "Add"; Scale 0.8; DeathSound "weapons/singboom"; Obituary "$C51_OB_SING"; }
	States
	{
	Spawn:
		SNGB AB 4 Bright;
		Loop;
	Death:
		SNGB C 8 Bright;
		SNGB D 8 Bright;
		SNGB E 8 Bright A_BFGSpray("CCASingularitySpray");
		SNGB F 8 Bright;
		SNGB G 8 Bright;
		SNGB H 6 Bright;
		Stop;
	}
}
class CCASingularitySpray : Actor
{
	Default { +NOBLOCKMAP; +NOGRAVITY; RenderStyle "Add"; Alpha 0.75; Scale 0.6; }
	States { Spawn: SNGB CDEF 4 Bright; Stop; }
}
